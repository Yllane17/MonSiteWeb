{
  "extends": [
    "development"
  ],
  "hints": {
    "meta-viewport": "off",
    "axe/forms": "off",
    "axe/name-role-value": [
      "default",
      {
        "input-button-name": "off"
      }
    ],
    "compat-api/css": [
      "default",
      {
        "ignore": [
          "mask-composite",
          "backdrop-filter"
        ]
      }
    ],
    "css-prefix-order": "off"
  }
}